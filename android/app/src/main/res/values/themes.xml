<resources>
    <style name="Theme.HarkQuant" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hq_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.HarkQuant.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hq_icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HarkQuant</item>
    </style>
</resources>
